<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BOS.Desktop - WinUI 3 / Windows App SDK project.
    On Windows with Visual Studio 2026, change to:
      <Project Sdk="Microsoft.NET.Sdk">
        <PropertyGroup>
          <OutputType>WinExe</OutputType>
          <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
          <UseWinUI>true</UseWinUI>
        </PropertyGroup>
    For CI/Linux builds, this compiles as a class library shell.
  -->

  <PropertyGroup>
    <RootNamespace>BOS.Desktop</RootNamespace>
    <Description>BOS Solutions - WinUI 3 Desktop shell (Windows-only)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BOS.Application\BOS.Application.csproj" />
  </ItemGroup>

</Project>
