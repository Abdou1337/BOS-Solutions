<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BOS.Desktop — WinUI 3 / Windows App SDK desktop application.
    
    This project targets net10.0-windows10.0.22621.0 with UseWinUI enabled.
    It requires Windows 11 and Visual Studio 2026 Insiders to build fully.
    
    On non-Windows platforms (e.g. Linux CI), the project restores and builds
    as an empty library so the solution remains intact. All WinUI source files
    and references are conditionally included only on Windows.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>BOS.Desktop</RootNamespace>
    <Description>BOS Solutions - WinUI 3 Desktop shell</Description>
  </PropertyGroup>

  <!-- Windows-only: full WinUI 3 configuration -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsSdkPackageVersion>10.0.22621.52</WindowsSdkPackageVersion>
  </PropertyGroup>

  <!-- Non-Windows: build as empty library (no source, no WinUI) -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinitionItems>false</EnableDefaultApplicationDefinitionItems>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectReference Include="..\BOS.Application\BOS.Application.csproj" />
  </ItemGroup>

</Project>
